{
  "name": "pinturillo-clone",
  "version": "1.0.0",
  "description": "Clon de Pinturillo 2: juego multijugador de dibujar y adivinar en tiempo real con Node.js, Express y Socket.io",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
